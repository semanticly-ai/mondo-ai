@prefix maprule: <https://w3id.org/mapping-rules/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Generated by `just align-valueset` from mondo_ai.align.rules. Do not hand-edit.

<https://w3id.org/mapping-rules/maprule> a skos:ConceptScheme ;
    dcterms:title "Mapping curation rules" ;
    dcterms:description "Named, citable rules for curating and reviewing mappings. A mapping decision is only meaningful relative to the rules it was made under, so these ids are what SSSOM curation_rule cells carry." ;
    skos:hasTopConcept maprule:EV, maprule:SC, maprule:PR, maprule:ST, maprule:RJ, maprule:CM .

maprule:blocksExactMatch a owl:DatatypeProperty ;
    rdfs:label "blocks exact match" ;
    rdfs:comment "True when this rule, once it fires, forbids skos:exactMatch." ;
    rdfs:range xsd:boolean .

maprule:isRejectionGround a owl:DatatypeProperty ;
    rdfs:label "is rejection ground" ;
    rdfs:comment "True when this rule is a terminal reason not to map at all." ;
    rdfs:range xsd:boolean .

maprule:EV a skos:Concept, skos:Collection ;
    skos:prefLabel "Evidence for sameness" ;
    skos:definition "What was actually observed that supports the mapping. Records evidence, not a verdict." ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    skos:member maprule:EV-001, maprule:EV-002, maprule:EV-003, maprule:EV-004, maprule:EV-005, maprule:EV-006, maprule:EV-007, maprule:EV-008, maprule:EV-009, maprule:EV-010, maprule:EV-011, maprule:EV-012 .

maprule:SC a skos:Concept, skos:Collection ;
    skos:prefLabel "Scope, granularity and undefined subsets" ;
    skos:definition "Where the two concepts differ in extension rather than in kind." ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    skos:member maprule:SC-001, maprule:SC-002, maprule:SC-003, maprule:SC-004, maprule:SC-005, maprule:SC-006, maprule:SC-007, maprule:SC-008 .

maprule:PR a skos:Concept, skos:Collection ;
    skos:prefLabel "Predicate selection" ;
    skos:definition "Which predicate the relation found actually licenses. Direction convention: in `subject predicate object`, `skos:narrowMatch` means the OBJECT is narrower." ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    skos:member maprule:PR-001, maprule:PR-002, maprule:PR-003, maprule:PR-004, maprule:PR-005, maprule:PR-006, maprule:PR-007, maprule:PR-008 .

maprule:ST a skos:Concept, skos:Collection ;
    skos:prefLabel "Structural integrity" ;
    skos:definition "Checks over the set rather than the row. Violations are set-level defects." ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    skos:member maprule:ST-001, maprule:ST-002, maprule:ST-003, maprule:ST-004, maprule:ST-005, maprule:ST-006 .

maprule:RJ a skos:Concept, skos:Collection ;
    skos:prefLabel "Rejection grounds" ;
    skos:definition "Terminal outcomes. A rejection is a finding and is recorded, not dropped." ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    skos:member maprule:RJ-001, maprule:RJ-002, maprule:RJ-003, maprule:RJ-004, maprule:RJ-005 .

maprule:CM a skos:Concept, skos:Collection ;
    skos:prefLabel "Conceptual model conflation (disease / phenotype)" ;
    skos:definition "The two resources hold genuinely different models of what an entity is, and the curator crossed that boundary knowingly. Conflation is a decision, not an error." ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    skos:member maprule:CM-001, maprule:CM-002, maprule:CM-003, maprule:CM-004, maprule:CM-005, maprule:CM-006, maprule:CM-007, maprule:CM-008, maprule:CM-009 .

maprule:EV-001 a skos:Concept ;
    skos:notation "EV-001" ;
    skos:prefLabel "exact match on primary label" ;
    skos:definition "Subject and object primary labels are identical. High confidence, very low cost." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-002 a skos:Concept ;
    skos:notation "EV-002" ;
    skos:prefLabel "exact match on normalised label" ;
    skos:definition "Identical after non-semantic normalisation only (case, accents, punctuation, whitespace). Equivalent in strength to EV-001." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-003 a skos:Concept ;
    skos:notation "EV-003" ;
    skos:prefLabel "exact match on exact synonym" ;
    skos:definition "One side's primary label equals the other's exact synonym. Medium-to-high confidence." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-004 a skos:Concept ;
    skos:notation "EV-004" ;
    skos:prefLabel "match after declared lexical transformation" ;
    skos:definition "Matched only after a documented, bounded rewrite (possessive, word order, British/American spelling, disease/disorder). The rule is recorded in subject_preprocessing." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-005 a skos:Concept ;
    skos:notation "EV-005" ;
    skos:prefLabel "proxy mapping via third resource" ;
    skos:definition "Both sides already map to the same concept in a trusted third resource." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-006 a skos:Concept ;
    skos:notation "EV-006" ;
    skos:prefLabel "lexical similarity only" ;
    skos:definition "Low edit distance, or one label contained in the other. Low confidence — never sufficient alone for exactMatch." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-007 a skos:Concept ;
    skos:notation "EV-007" ;
    skos:prefLabel "synonym similarity" ;
    skos:definition "Non-exact synonym overlap. Low confidence, not sufficient alone." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-008 a skos:Concept ;
    skos:notation "EV-008" ;
    skos:prefLabel "hierarchical corroboration" ;
    skos:definition "Parents, children or linked features are comparable. Medium confidence. A failing hierarchical comparison is weak evidence against, because primary organising relationships rarely correspond across semantic spaces." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-009 a skos:Concept ;
    skos:notation "EV-009" ;
    skos:prefLabel "definition comparison" ;
    skos:definition "Textual definitions were compared. Medium-to-high confidence, high cost." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-010 a skos:Concept ;
    skos:notation "EV-010" ;
    skos:prefLabel "full expert review" ;
    skos:definition "An expert aggregated hierarchy, axioms, definitions and external sources." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-011 a skos:Concept ;
    skos:notation "EV-011" ;
    skos:prefLabel "external source confirmation" ;
    skos:definition "The mapping is asserted by the source itself, via an explicit exact match." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:EV-012 a skos:Concept ;
    skos:notation "EV-012" ;
    skos:prefLabel "automated adjudication over retrieved candidates" ;
    skos:definition "Candidates were retrieved lexically and a model judged equivalence. Records the reasoning; does not by itself license a curated assertion." ;
    skos:broader maprule:EV ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:SC-001 a skos:Concept ;
    skos:notation "SC-001" ;
    skos:prefLabel "undefined residual subset (\"Other X\")" ;
    skos:definition "Object is a semantically undefined remainder class. MUST NOT be an exactMatch, even when the subject disease is listed under it as an inclusion term." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:SC-002 a skos:Concept ;
    skos:notation "SC-002" ;
    skos:prefLabel "\"unspecified\" or \"excluding X\" rubric" ;
    skos:definition "Object is scoped by exclusion; its extension is not stable. MUST NOT be an exactMatch." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:SC-003 a skos:Concept ;
    skos:notation "SC-003" ;
    skos:prefLabel "\"related conditions\" grouping" ;
    skos:definition "Object is an open-ended association bucket. MUST be skos:relatedMatch." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:SC-004 a skos:Concept ;
    skos:notation "SC-004" ;
    skos:prefLabel "disjunctive rubric" ;
    skos:definition "Object names two or more distinct diseases and is broader by construction. Not an exactMatch." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:SC-005 a skos:Concept ;
    skos:notation "SC-005" ;
    skos:prefLabel "target finer than subject" ;
    skos:definition "Object is a site, laterality, encounter, severity or stage variant. Object is narrower." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:SC-006 a skos:Concept ;
    skos:notation "SC-006" ;
    skos:prefLabel "subtype under type-agnostic rubric" ;
    skos:definition "Subject is a subtype and the object is the rubric that abstracts over it. Object is broader. Not an exactMatch unless SC-008 is declared." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:SC-007 a skos:Concept ;
    skos:notation "SC-007" ;
    skos:prefLabel "rubric coextensive with subject" ;
    skos:definition "The object's own subdivisions are all subtypes of the subject concept, so their extensions coincide. exactMatch is correct, including when the rubric's label carries 'unspecified'. Distinguishing this from SC-001 is the hardest judgement in this registry." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:SC-008 a skos:Concept ;
    skos:notation "SC-008" ;
    skos:prefLabel "granularity tolerance declared" ;
    skos:definition "The use case explicitly permits mapping up to the next best available concept. The predicate MUST still reflect the true relation." ;
    skos:broader maprule:SC ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-001 a skos:Concept ;
    skos:notation "PR-001" ;
    skos:prefLabel "same real-world concept" ;
    skos:definition "Subject and object denote the same disease." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-002 a skos:Concept ;
    skos:notation "PR-002" ;
    skos:prefLabel "object is a subclass" ;
    skos:definition "No target concept equals the subject; the object is narrower → skos:narrowMatch." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-003 a skos:Concept ;
    skos:notation "PR-003" ;
    skos:prefLabel "object is a superclass" ;
    skos:definition "No target concept equals the subject; the object is broader → skos:broadMatch." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-004 a skos:Concept ;
    skos:notation "PR-004" ;
    skos:prefLabel "object is a sibling" ;
    skos:definition "→ skos:closeMatch." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-005 a skos:Concept ;
    skos:notation "PR-005" ;
    skos:prefLabel "conceptually related only" ;
    skos:definition "No exact, broad, narrow or close fit → skos:relatedMatch. Should be rare." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-006 a skos:Concept ;
    skos:notation "PR-006" ;
    skos:prefLabel "exactMatch is not OWL equivalence" ;
    skos:definition "skos:exactMatch asserts referential sameness for integration purposes, not owl:equivalentClass." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-007 a skos:Concept ;
    skos:notation "PR-007" ;
    skos:prefLabel "prefer exact or broad" ;
    skos:definition "closeMatch and relatedMatch are hard to use analytically; an exclusion reason MUST be given where the external concept is out of scope." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:PR-008 a skos:Concept ;
    skos:notation "PR-008" ;
    skos:prefLabel "ambiguity is not a match" ;
    skos:definition "Two or more equally defensible candidates → assert nothing." ;
    skos:broader maprule:PR ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:ST-001 a skos:Concept ;
    skos:notation "ST-001" ;
    skos:prefLabel "proxy merge" ;
    skos:definition "Two object concepts from one resource both exactMatch a single subject. Disallowed for precise mappings; a core curator must resolve it." ;
    skos:broader maprule:ST ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:ST-002 a skos:Concept ;
    skos:notation "ST-002" ;
    skos:prefLabel "reverse proxy merge" ;
    skos:definition "Two subject concepts both exactMatch a single object id. Disallowed at every tier." ;
    skos:broader maprule:ST ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:ST-003 a skos:Concept ;
    skos:notation "ST-003" ;
    skos:prefLabel "object identifier must exist" ;
    skos:definition "The object id must be a real, current identifier in the target vocabulary at the declared version." ;
    skos:broader maprule:ST ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:ST-004 a skos:Concept ;
    skos:notation "ST-004" ;
    skos:prefLabel "object must not be obsolete" ;
    skos:definition "Deprecated or obsoleted target concepts must not carry exact matches." ;
    skos:broader maprule:ST ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:ST-005 a skos:Concept ;
    skos:notation "ST-005" ;
    skos:prefLabel "identifier is not a code" ;
    skos:definition "The object id is a chapter range or belongs to a different vocabulary than its prefix claims. Invalid regardless of the label's plausibility." ;
    skos:broader maprule:ST ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:ST-006 a skos:Concept ;
    skos:notation "ST-006" ;
    skos:prefLabel "subject must be in scope" ;
    skos:definition "The subject must be a disease, not a phenotypic feature or a gene." ;
    skos:broader maprule:ST ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround false .

maprule:RJ-001 a skos:Concept ;
    skos:notation "RJ-001" ;
    skos:prefLabel "no candidate found" ;
    skos:definition "Nothing in the target vocabulary denotes this concept." ;
    skos:broader maprule:RJ ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround true .

maprule:RJ-002 a skos:Concept ;
    skos:notation "RJ-002" ;
    skos:prefLabel "ambiguous candidates" ;
    skos:definition "Several defensible candidates, none clearly best." ;
    skos:broader maprule:RJ ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround true .

maprule:RJ-003 a skos:Concept ;
    skos:notation "RJ-003" ;
    skos:prefLabel "homonym" ;
    skos:definition "Labels agree but the concepts differ — the classic failure mode of label-only evidence." ;
    skos:broader maprule:RJ ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround true .

maprule:RJ-004 a skos:Concept ;
    skos:notation "RJ-004" ;
    skos:prefLabel "token overlap only" ;
    skos:definition "Candidate shares words but denotes a different disease. Retrieval noise." ;
    skos:broader maprule:RJ ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround true .

maprule:RJ-005 a skos:Concept ;
    skos:notation "RJ-005" ;
    skos:prefLabel "target out of scope" ;
    skos:definition "The target concept is not a disease under the subject resource's model." ;
    skos:broader maprule:RJ ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:CM-001 a skos:Concept ;
    skos:notation "CM-001" ;
    skos:prefLabel "disease/disorder conflation" ;
    skos:definition "Subject and object are technically distinct as disease vs disorder; conflated as acceptable." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:CM-002 a skos:Concept ;
    skos:notation "CM-002" ;
    skos:prefLabel "disease/phenotype conflation, murky case" ;
    skos:definition "The object is modelled as a sign, symptom or clinical finding while the subject is a disease, and the distinction is genuinely unclear. Conflated to avoid losing associations. Acceptable." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:CM-003 a skos:Concept ;
    skos:notation "CM-003" ;
    skos:prefLabel "disease/phenotype distinction clear-cut" ;
    skos:definition "Same shape as CM-002 but the distinction is unambiguous. Rejection ground." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:CM-004 a skos:Concept ;
    skos:notation "CM-004" ;
    skos:prefLabel "finding-vs-disorder conflation" ;
    skos:definition "Target separates clinical finding from disorder, as SNOMED does. Conflated deliberately." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:CM-005 a skos:Concept ;
    skos:notation "CM-005" ;
    skos:prefLabel "etiological vs phenomenological divergence" ;
    skos:definition "The same clinical picture is individuated by cause in one resource and by presentation in the other. Conflated where the use case does not distinguish them." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:CM-006 a skos:Concept ;
    skos:notation "CM-006" ;
    skos:prefLabel "susceptibility vs disease" ;
    skos:definition "Subject is a susceptibility or predisposition locus; object is the clinical disease. Rejection ground — these are not the same entity." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:CM-007 a skos:Concept ;
    skos:notation "CM-007" ;
    skos:prefLabel "gene-centric vs disease-centric" ;
    skos:definition "One side denotes a gene or molecular defect, the other a disease. Rejection ground." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .

maprule:CM-008 a skos:Concept ;
    skos:notation "CM-008" ;
    skos:prefLabel "cross-species analog" ;
    skos:definition "Entities are analogous across organisms rather than identical. Conflate only if the use case explicitly permits it." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch false ;
    maprule:isRejectionGround false .

maprule:CM-009 a skos:Concept ;
    skos:notation "CM-009" ;
    skos:prefLabel "injury/event vs inherited condition" ;
    skos:definition "Target rubric denotes an acute event or procedural complication where the subject denotes an inherited trait. Rejection ground." ;
    skos:broader maprule:CM ;
    skos:inScheme <https://w3id.org/mapping-rules/maprule> ;
    maprule:blocksExactMatch true ;
    maprule:isRejectionGround true .
